# Bedrock
AWS_REGION=us-east-1
AWS_PROFILE=default
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Rate limiter — strict 10/sec ceiling (capacity 1, refill 10).
# Raising capacity permits bursts; the strict ceiling is only guaranteed at 1.
RATE_LIMIT_CAPACITY=1
RATE_LIMIT_REFILL_PER_SECOND=10

# Sampling
SAMPLE_SIZE=120
RANDOM_SEED=

# Storage (deployment mode)
S3_BUCKET=tweet-behavioral-risk-analysis-fall-2026